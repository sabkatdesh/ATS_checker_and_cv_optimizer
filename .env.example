# ─── LLM ───────────────────────────────────────────────────────────────────────
# Phase 1: Replace Gemini with Azure AI Foundry GPT-5 mini
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini           # your deployment name in Azure portal
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Legacy (remove after Phase 1 LLM migration is complete)
GROQ_API_KEY=<your-groq-key>
GOOGLE_API_KEY=<your-google-gemini-key>
HF_TOKEN=<your-huggingface-token>

# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>      # backend only, never expose to frontend
SUPABASE_ANON_KEY=<your-anon-public-key>          # safe for frontend auth calls

# ─── API ───────────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000                      # set to production URL when deployed

# ─── Frontend (Vite env vars — Phase 7) ───────────────────────────────────────
# VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
# VITE_API_URL=http://localhost:8000
