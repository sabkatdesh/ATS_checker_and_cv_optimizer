# Copy to .env and fill in. Never commit .env.
# Names use "__" for nested settings (pydantic-settings, from M1 onward).

# ─── App ───────────────────────────────────────────────────────────────────────
ENV=dev
API__CORS_ORIGINS=["http://localhost:5173"]

# ─── Supabase (dev project: cv-optimizer-dev, Singapore) ──────────────────────
AUTH__SUPABASE_URL=https://iugoabvedjwvusuldeil.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_2hFl7GNAVhwkoIdL6cW2uw_ZloLaN9h   # public, safe for frontend
SUPABASE_SECRET_KEY=<sb_secret_... from Dashboard → Project Settings → API Keys>   # backend only
# Session-mode pooler connection string (Dashboard → Connect → Session pooler), with your DB password:
DB__DSN=postgresql://postgres.iugoabvedjwvusuldeil:<db-password>@aws-<n>-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── Redis (dev: Upstash Free; use the rediss:// TLS URL) ─────────────────────
REDIS__URL=rediss://default:<password>@<host>.upstash.io:6379

# ─── LLM (Bedrock; credentials come from the AWS profile / env) ───────────────
LLM__DEFAULT_PROVIDER=bedrock
AWS_REGION=us-east-1

# ─── Legacy (current code until M1/M2 replace it) ─────────────────────────────
SUPABASE_URL=https://iugoabvedjwvusuldeil.supabase.co
SUPABASE_SERVICE_KEY=<legacy service_role key, or the sb_secret key>
SUPABASE_ANON_KEY=sb_publishable_2hFl7GNAVhwkoIdL6cW2uw_ZloLaN9h
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

