# LLM__GEMINI_API_KEY=
# LLM__OLLAMA_BASE_URL=

# --- M4: database, auth, storage, bonus (see app/config/db_settings.py) ---
# DB__DSN=postgresql://user:password@host:5432/postgres
# AUTH__SUPABASE_URL=https://<ref>.supabase.co
# AUTH__JWKS_URL=
# AUTH__JWT_ISSUER=
# AUTH__HS256_SECRET=            # dev/test only; rejected when ENV is staging/prod
# STORAGE__SIGNED_URL_TTL_S=600
# GUARDS__HASH_PEPPER=
# API__TRUSTED_PROXY_HOPS=0
# API__CLIENT_IP_HEADER=
# BONUS__AMOUNT=100
# DELETION__GRACE_DAYS=7

# --- M4: auth config (names only; values live in the Supabase dashboard / CI secrets) ---
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_CAPTCHA_SECRET=     # local: Cloudflare Turnstile always-pass test secret
# SUPABASE_AUTH_SMTP_PASS=          # Resend API key, remote only
# Frontend (frontend/.env):
# VITE_TURNSTILE_SITE_KEY=          # unset = no captcha widget
# VITE_AUTH_GOOGLE=                 # set to 1 to show the Google button
